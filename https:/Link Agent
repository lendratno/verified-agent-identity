name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'zel'
        required: true
        default: 'lucian'
      agent_description:
        description: 'verified'
        required: true
        default: 'FAIAR AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'
        run: npx clawhub@latest install verified-agent-identity
        run: |
          cd scripts
          npm install
        run: node scripts/createNewEthereumIdentity.js
        run: |
          node scripts/manualLinkHumanToAgent.js --challenge '{"name": "zel", "description": "FAIAR AI Agent"}'
